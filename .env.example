# ── MindEase environment reference ──────────────────────────────────────────
# Copy to .env and fill in. Never commit real secrets.

# MySQL
MYSQL_ROOT_PASSWORD=mindease_secure_root
MYSQL_PASSWORD=mindease_secure

# API (server/.env mirrors these)
# Each of these three MUST be a different random value. The API refuses to start
# in production if any is weak or if the values collide, because a shared secret
# lets a credential minted for one flow verify as another:
#   JWT_SECRET      — access tokens and WebSocket tickets
#   REFRESH_SECRET  — refresh tokens (7 days)
#   TWO_FACTOR_SECRET — pending two-factor tickets (5 minutes)
# Generate each with:  openssl rand -base64 48
JWT_SECRET=change_me_access_secret
REFRESH_SECRET=change_me_refresh_secret
TWO_FACTOR_SECRET=change_me_two_factor_secret
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=

# Browser origins allowed by CORS (comma-separated; defaults to FRONTEND_URL)
# CORS_ORIGINS=https://mindease.app,https://www.mindease.app
FRONTEND_URL=http://localhost:3000

# Redis — REQUIRED in production (realtime push + caching; degrades silently when down)
# REDIS_URL=redis://default:password@host:6379

# Realtime connection caps. Per-user allows normal multi-tab use; the total is
# a process-wide ceiling that protects memory (each socket holds a 64-event
# send buffer). A non-numeric or non-positive value falls back to the default.
# MAX_CONNECTIONS_PER_USER=5
# MAX_TOTAL_CONNECTIONS=10000

# AI call resilience.
#
# AI_REQUEST_TIMEOUT_MS bounds a single Gemini call, so a hung request cannot
# pin an Express handler open for the SDK's own (much longer) default.
# The circuit breaker opens after AI_CIRCUIT_THRESHOLD consecutive failures and
# stays open for AI_CIRCUIT_COOLDOWN_MS, during which calls short-circuit to
# their local fallback instead of retrying a struggling provider.
# A non-numeric or non-positive value falls back to the default.
# AI_REQUEST_TIMEOUT_MS=20000
# AI_CIRCUIT_THRESHOLD=5
# AI_CIRCUIT_COOLDOWN_MS=60000

# Error tracking (optional — no-op when unset)
# SENTRY_DSN=
# SENTRY_RELEASE=

# Object storage for avatars (S3-compatible: AWS S3, Cloudflare R2, Railway volumes)
# REQUIRED in production — Railway's filesystem is ephemeral.
# S3_ENDPOINT=https://your-bucket.s3.amazonaws.com
# S3_BUCKET=mindease-avatars
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=https://cdn.mindease.app

# Payment provider for therapy packages.
# Leave BOTH blank and checkout settles through an in-process simulator, so a
# fresh clone runs end to end without a merchant account. The API refuses to
# start in production in that mode — a real deployment must supply credentials.
# Midtrans is the default for the Indonesian market.
# PAYMENT_PROVIDER=midtrans
# PAYMENT_SERVER_KEY=
# PAYMENT_CLIENT_KEY=
# PAYMENT_BASE_URL=https://app.midtrans.com
#
# PAYMENT_PROVIDER is validated against the known set {midtrans, simulator}.
# An unrecognised value is a boot error rather than a silent fallback, because
# anything that is not "midtrans" used to resolve to the simulator.
#
# Escape hatch for local/demo deployments that must not take real payments:
# allows the simulator even when NODE_ENV=production. Do NOT set this on a real
# deployment — it hands out free entitlements. docker-compose sets it so
# `docker compose up` boots without a merchant account.
# ALLOW_PAYMENT_SIMULATOR=true

# Web (client/.env.local) — must match the API's GOOGLE_CLIENT_ID
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_SITE_URL=https://mindease.app
# NEXT_PUBLIC_SENTRY_DSN=

# SMTP for password-reset/verification/booking emails.
# REQUIRED in production — email flows fail loudly when unset.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=MindEase <no-reply@mindease.app>

# WhatsApp reminders (optional — graceful fallback when unset)
# WA_GATEWAY_URL=https://api.fonnte.com/send
# WA_GATEWAY_TOKEN=

# Web push (optional — installable PWA + push notifications when set)
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:no-reply@mindease.app

# --- Video consultations -----------------------------------------------------
# Which transport carries a consultation.
#
#   livekit  authenticated. The server mints a short-lived, room-scoped access
#            token; the client never holds a key and there is no joinable URL.
#   jitsi    the previous behaviour: a bare iframe of the public meet.jit.si
#            deployment with an unguessable-but-unauthenticated URL. Retained
#            only as a fallback so a deployment without LiveKit still works.
#
# The default is jitsi on purpose. Failing closed with no video at all is worse
# for a consultation that is minutes from starting than a degraded one - but it
# IS degraded, the API reports it on every join, and the client says so on
# screen. Set this to livekit for any real deployment.
# VIDEO_PROVIDER=jitsi

# LiveKit server credentials. Required when VIDEO_PROVIDER=livekit; if any of
# the three is missing the API falls back to jitsi and logs why.
#
# Use a self-hosted LiveKit (docker-compose has a commented service) or
# LiveKit Cloud. Note the client also needs to reach the server over wss:, so
# the CSP connect-src allowlist has to cover the host.
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
