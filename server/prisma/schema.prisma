generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Basic User Model with Auth fields
model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String? // Nullable for Google Auth users
  name          String?
  avatar        String?
  role          String         @default("patient") // patient, doctor, admin
  phone_number  String?
  provider      String         @default("local") // "local" or "google"
  googleId      String?        @unique
  isBanned      Boolean        @default(false)
  isVerified    Boolean        @default(false)
  weeklyReportEnabled Boolean  @default(false)
  notificationPrefs String?    @db.Text // JSON: { appointment: {inApp,email}, message: {...}, system: {...} }
  referralCode  String?        @unique
  timezone      String?        @default("Asia/Jakarta")
  lastMoodNudgeAt DateTime?
  lastDeclineNudgeAt DateTime?
  failedAttempts Int           @default(0)
  lockedUntil   DateTime?
  totpSecret    String?
  totpEnabled   Boolean        @default(false)
  backupCodes   String?        @db.Text // JSON array of argon2 hashes, single-use
  // Highest accepted TOTP step; blocks replay inside the +/-1 step tolerance
  // window. An Int rather than BigInt: a step is seconds-since-epoch / 30, so
  // it stays well inside Int range, and Int cannot surprise a JSON serializer.
  lastTotpStep  Int?
  sessionCredits Int           @default(0) // referral reward: one free session per credit
  // Password recovery and email verification are independent flows: sharing
  // one OTP slot let a verification request silently invalidate an in-flight
  // password reset, and let a code from one flow be spent on the other.
  resetOtpHash  String?
  resetOtpExpiresAt DateTime?
  resetOtpAttempts Int         @default(0)
  verifyOtpHash String?
  verifyOtpExpiresAt DateTime?
  verifyOtpAttempts Int        @default(0)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("ActorLogs")
  appointments  Appointment[]
  reviews       Review[]
  messagesSent     Message[]      @relation("SentMessages")
  messagesReceived Message[]      @relation("ReceivedMessages")
  notifications Notification[]
  moodEntries   MoodEntry[]
  journalEntries JournalEntry[]
  assessments   Assessment[]
  reviewReports ReviewReport[]
  waitlistEntries WaitlistEntry[]
  packagePurchases PackagePurchase[]
  referralsMade Referral[]      @relation("ReferralsMade")
  referralReceived Referral?    @relation("ReferralReceived")
  pushSubscriptions PushSubscription[]
  riskAlerts RiskAlert[]
  doctorProfile Doctor?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Cron scan indexes. The mood-nudge and decline-nudge jobs look for patients
  // past a per-user timestamp within a role, and the weekly report looks for
  // opted-in patients by role. All three were full table scans on every run, on
  // every replica, before these existed.
  @@index([role, lastMoodNudgeAt])
  @@index([role, lastDeclineNudgeAt])
  @@index([weeklyReportEnabled, role])
}

model Doctor {
  id               Int                @id @default(autoincrement())
  userId           Int                @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty        String
  bio              String             @db.Text
  experience       Int                @default(0)
  // Denormalised aggregate, kept in step by `ReviewService.recalcDoctorRating`.
  // Defaults to 0 rather than 5.0: a clinician with no reviews yet must not be
  // presented to patients as a perfect 5.0, which is a false clinical claim.
  rating           Float              @default(0)
  totalReviews     Int                @default(0)
  languages        String?
  education        String?            @db.Text
  price            Int                @default(0)
  bankName         String?
  bankAccount      String?
  bankHolder       String?
  availability     String             @default("Available")
  verificationStatus String           @default("pending") // pending, approved, rejected
  licenseNumber    String?
  licenseIssuer    String?
  appointments     Appointment[]
  reviews          Review[]
  consultationSlots ConsultationSlot[]
  availabilityPatterns AvailabilityPattern[]
  waitlistEntries WaitlistEntry[]
  packages      Package[]
  followUps     FollowUp[]
  awayUntil     DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Directory indexes. Every directory query filters on `verificationStatus`
  // (unapproved clinicians are hidden) and then filters or sorts on one of
  // specialty / price / rating / experience, optionally excluding clinicians
  // inside an `awayUntil` window.
  @@index([verificationStatus, rating])
  @@index([specialty, price])
  @@index([experience])
  @@index([verificationStatus, awayUntil])
}

model Appointment {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId        Int
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slotId          Int?     @unique
  slot            ConsultationSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  appointmentDate DateTime
  startTime       String?
  endTime         String?
  consultationType String   @default("video") // video, voice, chat
  status          String   @default("pending") // pending, confirmed, cancelled, completed
  notes           String?  @db.Text
  meetingLink     String?
  idempotencyKey  String?  @unique
  reminderSentAt  DateTime?
  checkinSentAt   DateTime?
  packagePurchaseId Int?
  packagePurchase PackagePurchase? @relation(fields: [packagePurchaseId], references: [id], onDelete: SetNull)
  creditApplied  Boolean @default(false) // session paid with a referral credit
  preSessionData  PreSessionData?
  followUp        FollowUp?
  reviews         Review[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([doctorId, appointmentDate, status])
  @@index([userId, status])
  // The reminder and post-session check-in jobs claim work with a conditional
  // update on these column sets (sent-timestamp IS NULL, date in window, status
  // in set). Without them each claim scanned the whole appointments table, on
  // every replica, every ten minutes.
  @@index([reminderSentAt, appointmentDate, status])
  @@index([checkinSentAt, appointmentDate, status])
  @@index([userId, appointmentDate])
}

model Review {
  id            Int      @id @default(autoincrement())
  rating        Int
  comment       String   @db.Text
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId      Int
  doctor        Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId Int?     @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  reply         String?  @db.Text
  repliedAt     DateTime?
  hidden        Boolean  @default(false)
  reports       ReviewReport[]
  createdAt     DateTime @default(now())

  // Public review listings filter on `hidden` and order by date.
  @@index([doctorId, hidden, createdAt])
}

model ReviewReport {
  id         Int      @id @default(autoincrement())
  reviewId   Int
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String   @db.Text
  status     String   @default("open") // open, resolved, dismissed
  createdAt  DateTime @default(now())

  @@index([reviewId])
  @@index([status])
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  senderId   Int
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  isRead     Boolean  @default(false)
  readAt     DateTime?
  attachmentUrl String?
  attachmentType   String?       @db.VarChar(50)
  deletedAt  DateTime?
  reaction   String?
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId])
  // Unread-badge and conversation-list queries.
  @@index([receiverId, isRead])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  type      String? // appointment, message, system
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

model ConsultationSlot {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  appointment Appointment?

  @@index([doctorId, date, isBooked])
  // Two concurrent "create slot" requests can both pass an application-level
  // overlap check; this makes an exact duplicate a database error instead.
  @@unique([doctorId, date, startTime, endTime])
}

model AvailabilityPattern {
  id         Int      @id @default(autoincrement())
  doctorId   Int
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  weekday    Int // 0 (Monday) - 6 (Sunday)
  startTime  String
  endTime    String
  activeFrom DateTime
  activeUntil DateTime?
  createdAt  DateTime @default(now())

  @@index([doctorId])
  @@unique([doctorId, weekday, startTime, endTime])
}

model PreSessionData {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  questionsJson String?  @db.Text
  answersJson   String?  @db.Text
  briefingText  String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/**
 * A clinically significant risk signal raised by a self-report instrument, for
 * example a non-zero answer to PHQ-9 item 9.
 *
 * The score alone is not actionable — a care team needs to know that someone
 * disclosed a thought of self-harm, and needs a durable record that it was
 * raised and by whom it was acknowledged.
 */
model RiskAlert {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String   // "elevated" | "urgent"
  reason    String   @db.Text
  sourceType String  // e.g. "phq9"
  sourceId  Int?
  // Set once a clinician has seen and accepted the alert.
  acknowledgedAt   DateTime?
  acknowledgedById Int?
  notifiedDoctorUserId Int?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([acknowledgedAt])
  @@index([createdAt])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  // SHA-256 digest of the refresh token, never the token itself, so a leaked
  // database read cannot be replayed as a live session.
  tokenHash String   @unique @db.VarChar(64)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model MoodEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      Int
  notes     String?  @db.Text
  // Calendar day in the user's own timezone, as `YYYY-MM-DD`. Enforcing
  // uniqueness here makes "one mood log per day" a database invariant rather
  // than a check-then-create race in application code.
  moodDate  String   @db.VarChar(10)
  factors   String?  @db.Text // JSON array of factor tags
  createdAt DateTime @default(now())

  @@unique([userId, moodDate])
  @@index([userId, createdAt])
}

model JournalEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  aiSummary String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Assessment {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // phq9, gad7
  answersJson String  @db.Text
  score      Int
  severity   String // minimal, mild, moderate, moderately-severe, severe
  createdAt  DateTime @default(now())

  // Per-instrument history, and the ordered "your results over time" list.
  @@index([userId, type])
  @@index([userId, createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  targetType String?
  targetId  Int?
  meta      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model FollowUp {
  id              Int      @id @default(autoincrement())
  appointmentId   Int      @unique
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorId        Int
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  suggestedDate   DateTime
  startTime       String
  endTime         String
  consultationType String  @default("video")
  notes           String?  @db.Text
  status    String   @default("pending") // pending, accepted, declined, expired
  createdAt DateTime @default(now())

  // `status` is not indexed: follow-ups are only ever fetched by
  // `appointmentId` or `id`, so it was pure write amplification on a hot table.
  // `doctorId` *is* indexed, and cannot be otherwise — MySQL requires an index
  // backing `FollowUp_doctorId_fkey` and rejects the ALTER without one.
}

model WaitlistEntry {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId Int
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    String   @default("waiting") // waiting, notified, booked, expired
  // Notified at, so a stale notification can expire without a full scan.
  notifiedAt DateTime?
  createdAt DateTime @default(now())

  // One row per (doctor, patient) pair. The previous key included `status`,
  // which permitted `waiting` and `notified` rows to coexist for the same pair
  // — so re-joining after a notification created a duplicate and produced two
  // notifications when the slot opened.
  @@unique([doctorId, patientId])
  @@index([doctorId, status])
}

model Package {
  id           Int      @id @default(autoincrement())
  doctorId     Int
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  name         String
  description  String?  @db.Text
  sessionCount Int
  totalPrice   Int
  active       Boolean  @default(true)
  purchases    PackagePurchase[]
  createdAt    DateTime @default(now())

  @@index([doctorId])
}

model PackagePurchase {
  id           Int      @id @default(autoincrement())
  packageId    Int
  package      Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    sessionsLeft Int
    status       String   @default("active") // pending, active, completed
    // Set when a payment has been verified. A grant with no `paidAt` and no
    // `grantedByUserId` is not a legitimate entitlement.
    paidAt           DateTime?
    grantedByUserId  Int?
    // Price snapshot, so a later edit to `Package.totalPrice` cannot change what
    // a patient is credited against, and so a callback's amount can be re-checked
    // against what was actually ordered.
    totalPrice       Int      @default(0)
    sessionCount     Int      @default(0)
    // Provider transaction reference, retained for reconciliation.
    reference        String?
    appointments Appointment[]
    paymentOrder PaymentOrder?
    createdAt    DateTime @default(now())
  
    @@index([userId, createdAt])
    @@index([userId, status])
    // Serves the fallback lookup for callbacks whose order mapping predates
    // `PaymentOrder`.
    @@index([reference])
  }

  /**
   * A checkout in flight.
   *
   * The provider is told an `orderId` before the patient is redirected, and that
   * same id comes back on the callback. Holding the mapping explicitly — rather
   * than overloading a purchase column — keeps the callback path a single indexed
   * lookup and leaves room to record provider status transitions for
   * reconciliation.
   */
  model PaymentOrder {
    id         Int      @id @default(autoincrement())
    orderId    String   @unique @db.VarChar(64)
    purchaseId Int      @unique
    purchase   PackagePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
    amount     Int
    currency   String   @default("IDR")
    // pending, paid, failed, expired
    status     String   @default("pending")
    // Provider transaction id, once known.
    reference  String?  @db.VarChar(128)
    // Present only when the simulator settled the order.
    simulated  Boolean  @default(false)
    createdAt  DateTime @default(now())
    settledAt  DateTime?

    @@index([status])
    @@index([createdAt])
  }

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Unique per (user, endpoint), not globally unique. A globally unique
  // endpoint with an upsert that never wrote `userId` let a second user on a
  // shared device overwrite the first user's key pair, silently breaking their
  // notifications. Browsers also rotate keys for an unchanged endpoint, which
  // the per-user key handles in place.
  endpoint  String   @db.VarChar(500)
  p256dh    String   @db.VarChar(500)
  auth      String   @db.VarChar(500)
  userAgent String?
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}

model Referral {
  id         Int      @id @default(autoincrement())
  referrerId Int
  referrer   User     @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId Int      @unique
  referred   User     @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)
  code       String
  status     String   @default("pending") // pending, credited
  createdAt  DateTime @default(now())

  @@index([referrerId])
  @@index([status])
}
